# Copy to .env.local for local development, and add the same values in
# Vercel > Project > Settings > Environment Variables for production.
# Never commit real values.

# Public URL of the site (used for metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=https://unimatch.app

# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase SECRET key (Project Settings > API Keys > Secret keys, starts with sb_secret_).
# The legacy "service_role" key also works. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Random string used to hash IP addresses for rate limiting.
# Generate one with: openssl rand -hex 32
WAITLIST_IP_SALT=
